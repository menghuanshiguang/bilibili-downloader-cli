#!/usr/bin/env bash
# =====================================================================
# bilidown - B站音视频下载 CLI (bilibili-downloader-cli)
# 统一入口, 分发到 lib/ 下各功能脚本
#
# 用法:
#   bilidown <子命令> [参数...]
#
# 子命令:
#   dl <URL|BV号> ...    下载音频/视频 (alias: download, d)
#   search <关键词> [N]   搜索视频 (alias: s)
#   login [cookies路径]   扫码登录解锁高清 (alias: l)
#   formats <URL|BV号>    查询可用格式/最高分辨率 (alias: fmt)
#   parts <URL|BV号>      查询分P列表 (alias: p)
#   find <URL|BV号> <词>  按关键词定位合集分P (alias: findpart, f)
#   preview <URL|BV号>    生成预览页(封面+播放) (alias: v)
#   space <UID|空间URL>   获取UP主主页视频列表 (alias: sp)
#   help|-h               帮助
#   version|-v            版本
#
# 完整参数透传, 例:
#   bilidown dl "BV1GJ411x7h7" audio ~/Downloads mp4 480 1 "1:30-2:45"
# =====================================================================
set -euo pipefail

VERSION="1.0.0"

# ---------- 定位 lib 目录 (支持软链安装) ----------
resolve_self() {
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
        local dir="$(cd "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    echo "$(cd "$(dirname "$src")" && pwd)"
}
SELF_DIR="$(resolve_self)"
LIB_DIR="${BILIDOWN_LIB_DIR:-$SELF_DIR/../lib}"
LIB_DIR="$(cd "$LIB_DIR" && pwd)"

# ---------- 帮助 ----------
usage() {
    cat <<'EOF'
bilidown - B站音视频下载 CLI

用法: bilidown <子命令> [参数...]

子命令:
  dl      下载音频/视频   bilidown dl <URL|BV号> [audio|video|list] [输出目录] [容器] [分辨率] [分P号] [截取区间]
  search  搜索视频         bilidown search <关键词> [条数]
  login   扫码登录解锁高清  bilidown login [cookies路径]
  formats 查询格式/画质    bilidown formats <URL|BV号>
  parts   查询分P列表      bilidown parts <URL|BV号>
  find    按歌名定位分P    bilidown find <URL|BV号> <关键词>
  preview 生成预览页       bilidown preview <URL|BV号>

通用:
  help, -h, --help        显示帮助
  version, -v, --version  显示版本

示例:
  bilidown dl "BV1GJ411x7h7" audio
  bilidown dl "BV1GJ411x7h7" video ~/Downloads mp4 1080
  bilidown search "卓依婷 萍聚"
  bilidown find "BV16v411L7js" "小草"
  bilidown preview "BV16v411L7js?p=121"
EOF
}

run_lib() {
    local script="$1"; shift
    exec bash "$LIB_DIR/$script" "$@"
}

# ---------- 子命令分发 ----------
CMD="${1:-help}"
case "$CMD" in
    dl|download|d)
        shift
        run_lib bilibili-dl.sh "$@"
        ;;
    search|s)
        shift
        run_lib bilibili-search.sh "$@"
        ;;
    login|l)
        shift
        run_lib bilibili-login.sh "$@"
        ;;
    formats|fmt)
        shift
        run_lib bilibili-formats.sh "$@"
        ;;
    parts|p)
        shift
        run_lib bilibili-parts.sh "$@"
        ;;
    find|findpart|f)
        shift
        run_lib bilibili-findpart.sh "$@"
        ;;
    preview|v)
        shift
        run_lib bilibili-preview.sh "$@"
        ;;
    space|sp)
        shift
        run_lib bilibili-space.sh "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    version|-v|--version)
        echo "bilidown $VERSION (bilibili-downloader-cli)"
        ;;
    *)
        echo "错误: 未知子命令 '$CMD'" >&2
        usage
        exit 1
        ;;
esac
